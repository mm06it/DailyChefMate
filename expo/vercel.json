{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "bun install",
  "buildCommand": "npx expo export -p web && node scripts/inject-html-meta.js",
  "outputDirectory": "dist",
  "trailingSlash": false,
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/all", "destination": "/index.html" },
    { "source": "/homemade", "destination": "/index.html" },
    { "source": "/favorites", "destination": "/index.html" },
    { "source": "/refrigerator", "destination": "/index.html" },
    { "source": "/planner", "destination": "/index.html" },
    { "source": "/social", "destination": "/index.html" },
    { "source": "/admin", "destination": "/index.html" },
    { "source": "/profile", "destination": "/index.html" },
    { "source": "/settings", "destination": "/index.html" },
    { "source": "/recipe-detail", "destination": "/index.html" },
    { "source": "/generated-recipes", "destination": "/index.html" },
    { "source": "/add-recipe", "destination": "/index.html" },
    { "source": "/auth", "destination": "/index.html" },
    { "source": "/user/:id", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'none'" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()" }
      ]
    }
  ]
}
