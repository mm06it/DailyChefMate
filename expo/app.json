{
  "expo": {
    "name": "DailyChefMate",
    "slug": "dailychefmate",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "dailychefmate",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dailychefmate.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.dailychefmate.app"
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://www.dailychefmate.com/"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "DailyChefMate braucht Zugriff auf deine Fotos, um ein Rezeptbild zu setzen."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
