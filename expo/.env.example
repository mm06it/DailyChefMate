# Base URL of the deployed API (leave unset in local dev; auto-detected)
EXPO_PUBLIC_API_BASE_URL=

# Optional: enables AI-generated recipe suggestions in the recipe search.
# Without a key, search still works normally via TheMealDB, just without AI enrichment.
AI_API_KEY=
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_MODEL=gpt-4o-mini
