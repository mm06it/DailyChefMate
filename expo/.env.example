# Convex deployment URL — printed by `npx convex dev` on first run (also
# written to .env.local automatically). Required for the app to load any data
# or auth at all.
EXPO_PUBLIC_CONVEX_URL=

# --- Convex deployment env vars (set with `npx convex env set`, NOT here) ---
# AI_API_KEY   — enables AI recipe enrichment + German translation. Without it
#                search still works via TheMealDB and recipes stay in English.
# AI_API_URL   — defaults to https://api.openai.com/v1/chat/completions
# AI_MODEL     — defaults to gpt-4o-mini
# SPOONACULAR_API_KEY — enables ingredient search via Spoonacular (TheMealDB fallback otherwise)
# AUTH_RESEND_KEY, AUTH_EMAIL_FROM — email OTP delivery
# ADMIN_EMAIL  — the account treated as admin
